{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2019",
    "isolatedModules": false,
    "incremental": false,
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "jest.setup.ts"
  ]
}
